# Copilot Studio agent connection settings for the Microsoft Agent Framework.
# Copy this file to ".env" and fill in the values for your environment.

# Environment ID where your Copilot Studio agent is deployed.
COPILOTSTUDIOAGENT__ENVIRONMENTID=your-environment-id

# The agent identifier / schema name of your published Copilot Studio agent.
COPILOTSTUDIOAGENT__SCHEMANAME=your-agent-schema-name

# Application (client) ID of your Entra ID App Registration.
COPILOTSTUDIOAGENT__AGENTAPPID=your-app-registration-client-id

# Directory (tenant) ID of your Entra ID App Registration.
COPILOTSTUDIOAGENT__TENANTID=your-tenant-id
